ADMIN_KEY=123456
# DATABASE_URL examples:
#   SQLite:  sqlite:///./pair_events.db
#   MySQL:   mysql+pymysql://USER:PASSWORD@HOST:3306/love_book?charset=utf8mb4
# Special chars in the password must be percent-encoded (e.g. ! -> %21).
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/love_book?charset=utf8mb4
UPLOAD_DIR=uploads
MAX_VOICE_BYTES=10485760
MAX_IMAGE_BYTES=10485760

# Optional: used by scripts/migrate_sqlite_to_mysql.py to read legacy data.
SQLITE_SOURCE_URL=sqlite:///./pair_events.db

# MySQL credentials are only required by migration / admin helpers.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=love_book

# 邮件服务配置（QQ 邮箱 SSL 示例）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=you@example.com
SMTP_FROM_NAME=我们之间的小事
SMTP_USE_SSL=1

# 邮件中跳转链接的前端域名
APP_WEB_URL=http://localhost:3000
