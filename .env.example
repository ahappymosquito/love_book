ADMIN_KEY=change-me-please
# DATABASE_URL examples:
#   SQLite:  sqlite:///./pair_events.db
#   MySQL:   mysql+pymysql://USER:PASSWORD@HOST:3306/love_book?charset=utf8mb4
# Special chars in the password must be percent-encoded (e.g. ! -> %21).
DATABASE_URL=mysql+pymysql://user:password%21@qrqto.club:3306/love_book?charset=utf8mb4
UPLOAD_DIR=uploads
MAX_VOICE_BYTES=10485760
MAX_IMAGE_BYTES=10485760

# Optional: used by scripts/migrate_sqlite_to_mysql.py to read legacy data.
SQLITE_SOURCE_URL=sqlite:///./pair_events.db

# MySQL credentials are only required by migration / admin helpers.
MYSQL_HOST=qrqto.club
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=love_book

# 邮件服务配置（QQ 邮箱 SSL 示例）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=you@example.com
SMTP_FROM_NAME=我们之间的小事
SMTP_USE_SSL=1

# 邮件中跳转链接的前端域名（必须与对外可访问域名一致）
APP_WEB_URL=https://qrqto.club

# 前端 build-time 注入（生产默认通过 Caddy 同源反代 /api；入口链接由浏览器当前 origin 生成）
# NEXT_PUBLIC_API_BASE=/api

# Home reminder public APIs:
# - Hitokoto quote: https://v1.hitokoto.cn/?c=e&c=f&max_length=30&encode=json
# - China holiday info: https://timor.tech/api/holiday/info/{YYYY-MM-DD}
# Both require no key. Backend falls back to local love quotes or skips holiday tags on failure.
