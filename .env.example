# Copy to .env and fill in real values. Never commit .env.
ADMIN_KEY=change-me-please

# Local development default. Production should use MySQL:
# mysql+pymysql://USER:PASSWORD@HOST:3306/love_book?charset=utf8mb4
# Special chars in the password must be percent-encoded (e.g. ! -> %21).
DATABASE_URL=sqlite:///./pair_events.db
MAX_IMAGE_BYTES=10485760
MEDIA_ROOT=/app/media
MEDIA_STORAGE=local

# Optional MySQL fields for operators who manage the database separately.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=love_book
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=love_book

# Mail settings. Use your own SMTP account; do not reuse example addresses.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=you@example.com
SMTP_FROM_NAME=Love Book
SMTP_USE_SSL=1

# Frontend URL embedded in notification emails. Local default is localhost.
APP_WEB_URL=http://localhost:3000

# AMap Web service key. Keep the real key only in .env / server environment.
AMAP_MAPS_API_KEY=your-amap-maps-api-key

# LLM config for admin-managed model selection. Keep the real API key only in .env.
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_API_KEY=your-llm-api-key
LLM_PROTOCOL=openai
LLM_MODEL=gpt-4.1-mini

# Frontend build-time injection. Production uses Caddy same-origin /api.
# NEXT_PUBLIC_API_BASE=/api

# ===== Agent SSH publish. Read this block; do not invent hosts or IPs. =====
# Host names must match ~/.ssh/config Host entries. Never put private keys here.
# Add another host by appending the name to LOVE_BOOK_SSH_HOSTS and filling
# LOVE_BOOK_SSH_<NAME>_* where NAME is the host with non-alnum turned to _.
# Example extra host: LOVE_BOOK_SSH_HOSTS=ts3_qrqto,root_qrqto,lab_qrqto
LOVE_BOOK_SSH_HOSTS=ts3_qrqto,root_qrqto
LOVE_BOOK_SSH_DEFAULT_HOST=ts3_qrqto
LOVE_BOOK_SSH_UPDATE_HOST=root_qrqto
LOVE_BOOK_SSH_COMPOSE_DIR=/home/ts3/love-book
LOVE_BOOK_SSH_HEALTH_URL=https://qrqto.club/api/health
LOVE_BOOK_SSH_SITE_URL=https://qrqto.club/
LOVE_BOOK_SSH_BACKUP_ROOT=/home/ts3/backups/love_book
LOVE_BOOK_SSH_BACKUP_COMMAND=/home/ts3/bin/love-book-backup
LOVE_BOOK_SSH_UPDATE_COMMAND=bash /home/ts3/love-book/update.sh
LOVE_BOOK_SSH_BACKEND_IMAGE=ghcr.io/ahappymosquito/love_book-backend:latest
LOVE_BOOK_SSH_FRONTEND_IMAGE=ghcr.io/ahappymosquito/love_book-frontend:latest
LOVE_BOOK_SSH_CONNECT_TIMEOUT=20

LOVE_BOOK_SSH_TS3_QRQTO_USER=ts3
LOVE_BOOK_SSH_TS3_QRQTO_ROLE=production-app
LOVE_BOOK_SSH_TS3_QRQTO_LABEL=生产应用账号
LOVE_BOOK_SSH_TS3_QRQTO_CAPABILITIES=check,status,backup,run
LOVE_BOOK_SSH_TS3_QRQTO_UPDATE_STYLE=none
LOVE_BOOK_SSH_TS3_QRQTO_UPDATE_HOST=root_qrqto
LOVE_BOOK_SSH_TS3_QRQTO_NOTES=日常检查入口。ts3 不能拉私有 GHCR，发布请用 LOVE_BOOK_SSH_UPDATE_HOST。

LOVE_BOOK_SSH_ROOT_QRQTO_USER=root
LOVE_BOOK_SSH_ROOT_QRQTO_ROLE=production-admin
LOVE_BOOK_SSH_ROOT_QRQTO_LABEL=生产管理员账号
LOVE_BOOK_SSH_ROOT_QRQTO_CAPABILITIES=check,status,update,backup,run
LOVE_BOOK_SSH_ROOT_QRQTO_UPDATE_STYLE=updater
LOVE_BOOK_SSH_ROOT_QRQTO_BACKUP_COMMAND=runuser -u ts3 -- env HOME=/home/ts3 /home/ts3/bin/love-book-backup
LOVE_BOOK_SSH_ROOT_QRQTO_NOTES=生产更新入口。跑已安装的 update.sh。未经当次明确授权不要 --yes。
