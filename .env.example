# Copy to .env and fill in real values. Never commit .env.
ADMIN_KEY=change-me-please

# Local development default. Production should use MySQL:
# mysql+pymysql://USER:PASSWORD@HOST:3306/love_book?charset=utf8mb4
# Special chars in the password must be percent-encoded (e.g. ! -> %21).
DATABASE_URL=sqlite:///./pair_events.db
MAX_IMAGE_BYTES=10485760
MEDIA_ROOT=/app/media
MEDIA_STORAGE=local

# Optional MySQL fields for operators who manage the database separately.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=love_book
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=love_book

# Mail settings. Use your own SMTP account; do not reuse example addresses.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=you@example.com
SMTP_FROM_NAME=Love Book
SMTP_USE_SSL=1

# Frontend URL embedded in notification emails. Local default is localhost.
APP_WEB_URL=http://localhost:3000

# AMap Web service key. Keep the real key only in .env / server environment.
AMAP_MAPS_API_KEY=your-amap-maps-api-key

# LLM config for admin-managed model selection. Keep the real API key only in .env.
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_API_KEY=your-llm-api-key
LLM_PROTOCOL=openai
LLM_MODEL=gpt-4.1-mini

# Frontend build-time injection. Production uses Caddy same-origin /api.
# NEXT_PUBLIC_API_BASE=/api

# Agent SSH publish. Only ~/.ssh/config Host names; do not put keys here.
# First name is the default check host. A Host whose User is root publishes.
LOVE_BOOK_SSH_HOSTS=ts3_qrqto,root_qrqto
