# 反向代理共用片段，被 db.example.com.conf 通过 include 引入
# 注意：本文件以 .locations 结尾，不会被 /etc/nginx/conf.d/*.conf 通配匹配

# 后端 API：/api/* -> backend:8000/* （去掉 /api 前缀）
location /api/ {
    proxy_pass http://love_book_backend/;
    proxy_redirect off;
    proxy_buffering off;
    proxy_request_buffering off;
}

# 后端文档（管理调试时可用）
location = /docs {
    proxy_pass http://love_book_backend/docs;
}
location = /openapi.json {
    proxy_pass http://love_book_backend/openapi.json;
}

# Next.js 静态资源长缓存
location /_next/static/ {
    proxy_pass http://love_book_frontend;
    proxy_cache_bypass $http_upgrade;
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
}

# 站点根路径 / 其它前端路由全部交给 Next.js
location / {
    proxy_pass http://love_book_frontend;
    proxy_cache_bypass $http_upgrade;
}
