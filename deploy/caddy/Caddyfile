# Rollback-only Caddyfile. Production public 80/443 is host nginx in deploy/nginx.
# Live CDN files remain in /var/www/cdn.qrqto.club; the public name is cdn.tingle272.xyz.
# Do not start this next to host nginx.

tingle272.xyz, www.tingle272.xyz {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}

	handle /docs {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
