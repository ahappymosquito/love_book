# Rollback-only Caddyfile. Production public 80/443 is host nginx in deploy/nginx.
# Live servers also served cdn.qrqto.club from /var/www/cdn.qrqto.club; that vhost
# is now deploy/nginx/sites/cdn.qrqto.club.conf. Do not start this next to host nginx.

qrqto.club, www.qrqto.club {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}

	handle /docs {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
